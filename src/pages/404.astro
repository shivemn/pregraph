---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="lost">
    <h1><span class="board">No such station</span></h1>
    <p class="quiet">This page doesn't exist. It may have moved, or the link has a typo in it.</p>
    <p><a href="/">Back to the start</a></p>
  </div>
</Base>

<style>
  .lost { padding: 64px 0; display: grid; gap: 14px; }
</style>
