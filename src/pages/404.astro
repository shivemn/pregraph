---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="lost">
    <h1>There's no stop here.</h1>
    <p class="quiet">The page may have moved, or the link has a typo in it.</p>
    <p><a href="/">Back to the start</a></p>
  </div>
</Base>

<style>
  .lost { padding: 64px 0; display: grid; gap: 14px; }
</style>
