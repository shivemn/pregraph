---
import Base from '../../layouts/Base.astro';
import { content, listOf } from '../../lib/site';
import { TIERS } from '../../lib/schema';

export function getStaticPaths() {
  return content().concepts.map((x) => ({ params: { id: x.id } }));
}

const c = content();
const concept = c.concepts.find((x) => x.id === Astro.params.id)!;
const byId = new Map(c.concepts.map((x) => [x.id, x]));
const resources = new Map(c.resources.map((r) => [r.id, r]));
const area = c.areas.find((a) => a.id === concept.area)!;

const before = concept.requires.map((id) => byId.get(id)!);
const helpful = concept.recommends.map((id) => byId.get(id)!);
const after = c.concepts.filter((x) => x.requires.includes(concept.id));
const inRoles = c.roles.flatMap((r) =>
  TIERS.filter((t) => r.tiers[t.id].includes(concept.id)).map((t) => ({ role: r, tier: t })),
);
const kindLabel = concept.kind === 'tool' ? 'Tool' : concept.kind === 'project' ? 'Project to build' : null;

const groups = [
  { role: 'primary', heading: 'Start here' },
  { role: 'alternative', heading: 'Another way in' },
  { role: 'deep-dive', heading: 'If you want to go further' },
] as const;
---

<Base title={concept.title} description={concept.summary}>
  <article data-area={concept.area}>
    <header class="head">
      <p class="chips">
        <span class="area-chip">{area.title}</span>
        {kindLabel && <span class="kind">{kindLabel}</span>}
      </p>
      <h1>{concept.title}</h1>
      <p class="summary">{concept.summary}</p>
      <p class="quiet">
        About <span class="num">{concept.hours}</span> hours{concept.kind === 'project' ? ' to build' : ' of study'}.
      </p>
    </header>

    <section aria-labelledby="learn">
      <h2 id="learn">Where to learn it</h2>
      {
        groups.map(({ role, heading }) => {
          const sections = concept.resources.filter((s) => s.role === role);
          if (sections.length === 0) return null;
          return (
            <div class="group">
              <h3>{heading}</h3>
              {sections.map((s) => {
                const r = resources.get(s.resource)!;
                return (
                  <div class="source">
                    <a class="source-title" href={r.url} rel="noopener">{r.title}</a>
                    <p class="quiet">{r.author}</p>
                    <p class="use">Use: {s.locator}</p>
                    {(!r.free || !s.verified) && (
                      <p class="flags">
                        {!r.free && <span class="flag paid">Paid</span>}
                        {!s.verified && (
                          <span class="flag" title="Nobody has opened this resource to confirm the chapter or lecture numbers yet.">
                            Section not checked yet
                          </span>
                        )}
                      </p>
                    )}
                    {r.note && <p class="faint note">{r.note}</p>}
                  </div>
                );
              })}
            </div>
          );
        })
      }
    </section>

    {
      inRoles.length > 0 && (
        <section aria-labelledby="roles">
          <h2 id="roles">Which roles ask for it</h2>
          <ul class="role-uses">
            {inRoles.map(({ role, tier }) => (
              <li>
                <a href={`/roles/${role.id}`}>{role.title}</a>
                <span class="quiet"> {tier.id === 'hire' ? 'to get hired' : tier.id === 'firstYear' ? 'in the first year' : 'good to have'}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="neighbours" aria-labelledby="around">
      <h2 id="around">Before and after</h2>
      <div class="lanes">
        <div class="lane">
          <h3>Learn first</h3>
          {before.length === 0 ? <p class="quiet">Nothing. You can start here.</p> : (
            <ul>{before.map((x) => <li data-area={x.area}><a href={`/concepts/${x.id}`}>{x.title}</a></li>)}</ul>
          )}
          {helpful.length > 0 && (
            <p class="faint small">Helps to know: {helpful.map((x, i) => (
              <>{i > 0 && (i === helpful.length - 1 ? ' and ' : ', ')}<a href={`/concepts/${x.id}`}>{x.title}</a></>
            ))}</p>
          )}
        </div>
        <div class="lane this" data-area={concept.area}>
          <span class="dot" aria-hidden="true"></span>
          <strong>{concept.title}</strong>
        </div>
        <div class="lane">
          <h3>Opens up</h3>
          {after.length === 0 ? <p class="quiet">Nothing else on the map yet.</p> : (
            <ul>{after.map((x) => <li data-area={x.area}><a href={`/concepts/${x.id}`}>{x.title}</a></li>)}</ul>
          )}
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .head { display: grid; gap: 12px; padding: 24px 0 8px; }
  .chips { display: flex; gap: 12px; align-items: center; }
  .kind { font-size: 0.8125rem; font-weight: 700; padding: 1px 8px; border-radius: 4px; border: 1.5px solid var(--line); color: var(--line); }
  .role-uses { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 6px; }
  .role-uses a { font-weight: 650; }
  .summary { font-size: 1.25rem; line-height: 1.45; max-width: 56ch; }

  section { margin-top: 44px; }
  h2 { margin-bottom: 8px; }

  .group { margin-top: 20px; }
  .group h3 { font-size: 0.9375rem; color: var(--ink-2); font-weight: 650; margin-bottom: 8px; }
  .source { padding: 14px 0 14px 18px; border-left: 3px solid var(--line); display: grid; gap: 3px; }
  .source + .source { margin-top: 10px; }
  .source-title { font-size: 1.125rem; font-weight: 700; }
  .use { font-weight: 600; }
  .flags { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
  .note { font-size: 0.9375rem; }
  .small { font-size: 0.9375rem; margin-top: 8px; }

  .lanes { display: grid; grid-template-columns: 1fr auto 1fr; gap: 28px; align-items: start; margin-top: 16px; }
  .lane h3 { font-size: 0.9375rem; color: var(--ink-2); font-weight: 650; margin-bottom: 8px; }
  .lane ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .lane li { display: flex; align-items: center; gap: 10px; }
  .lane li::before { content: ''; width: 12px; height: 12px; border-radius: 50%; border: 3px solid var(--line); flex: none; }
  .this { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 26px 8px 0; text-align: center; max-width: 16ch; }
  .this .dot { width: 26px; height: 26px; border-radius: 50%; background: var(--line); box-shadow: 0 0 0 5px color-mix(in srgb, var(--line) 22%, transparent); }

  @media (max-width: 640px) {
    .lanes { grid-template-columns: 1fr; gap: 20px; }
    .this { flex-direction: row; padding: 0; max-width: none; text-align: left; }
  }
</style>
