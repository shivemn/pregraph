---
import Base from '../../layouts/Base.astro';
import { content, listOf } from '../../lib/site';
import { TIERS, MEDIA } from '../../lib/schema';
import { stopDetails } from '../../lib/stops';
import '../../styles/picks.css';

export function getStaticPaths() {
  return content().concepts.map((x) => ({ params: { id: x.id } }));
}

const c = content();
const concept = c.concepts.find((x) => x.id === Astro.params.id)!;
const byId = new Map(c.concepts.map((x) => [x.id, x]));
const resources = new Map(c.resources.map((r) => [r.id, r]));
const area = c.areas.find((a) => a.id === concept.area)!;

const before = concept.requires.map((id) => byId.get(id)!);
const helpful = concept.recommends.map((id) => byId.get(id)!);
const after = c.concepts.filter((x) => x.requires.includes(concept.id));
const inRoles = c.roles.flatMap((r) =>
  TIERS.filter((t) => r.tiers[t.id].includes(concept.id)).map((t) => ({ role: r, tier: t })),
);
const kindLabel = concept.kind === 'tool' ? 'Tool' : concept.kind === 'project' ? 'Project to build' : null;

const detail = stopDetails(c).find((d) => d.id === concept.id)!;
const LABEL = { read: 'Read', watch: 'Watch', practice: 'Practise' } as const;
const MISSING = {
  read: 'No book or written guide picked yet.',
  watch: 'No video course picked yet.',
  practice: 'No practice set picked yet.',
} as const;
const suggest = (m: keyof typeof LABEL) =>
  `https://github.com/shivemn/pregraph/issues/new?title=${encodeURIComponent(`${LABEL[m]} pick for ${concept.title}`)}`;
---

<Base title={concept.title} description={concept.summary}>
  <article data-area={concept.area}>
    <header class="head">
      <p class="chips">
        <span class="area-chip">{area.title}</span>
        {kindLabel && <span class="kind">{kindLabel}</span>}
      </p>
      <h1><span class="board">{concept.title}</span></h1>
      <p class="summary">{concept.summary}</p>
      <p class="quiet">
        About <span class="num">{concept.hours}</span> hours{concept.kind === 'project' ? ' to build' : ' of study'}.
      </p>
    </header>

    <section aria-labelledby="learn">
      <h2 id="learn">Where to learn it</h2>
      <div class="picks">
        {
          MEDIA.map((m) => {
            const src = detail.picks[m];
            return (
              <div class:list={['pick', { missing: !src }]}>
                <div class="pick-label">
                  {m === 'read' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5C6 4 9 4 12 6c3-2 6-2 9-.5V19c-3-1.5-6-1.5-9 .5-3-2-6-2-9-.5z" /><path d="M12 6v13.5" /></svg>}
                  {m === 'watch' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="M10 9.2v5.6l4.6-2.8z" class="fill" /></svg>}
                  {m === 'practice' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.2-4.6L15.6 5a1.9 1.9 0 0 1 2.7 0l.7.7a1.9 1.9 0 0 1 0 2.7L8.6 18.8z" /><path d="M13.5 7l3.5 3.5" /></svg>}
                  {LABEL[m]}
                </div>
                {src ? (
                  <div class="pick-body">
                    <a class="pick-title" href={src.url} rel="noopener">{src.title}</a>
                    <p class="faint">{src.author}</p>
                    <p class="pick-use">{src.locator}</p>
                    {src.why && <p class="quiet">{src.why}</p>}
                    {src.note && <p class="faint">{src.note}</p>}
                    {(!src.free || !src.verified) && (
                      <p class="flags">
                        {!src.free && <span class="flag paid">Paid</span>}
                        {!src.verified && <span class="flag" title="Nobody has opened it yet to confirm the chapter or lecture numbers.">Section not checked yet</span>}
                      </p>
                    )}
                  </div>
                ) : (
                  <div class="pick-body">
                    <p class="quiet">{MISSING[m]}</p>
                    <a class="text-button" href={suggest(m)} rel="noopener">Suggest one</a>
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
      {
        detail.others.length > 0 && (
          <div class="more">
            <h3>Other options</h3>
            <ul>
              {detail.others.map((s) => (
                <li>
                  <a href={s.url} rel="noopener">{s.title}</a>
                  <span class="faint"> ({LABEL[s.medium].toLowerCase()}{s.role === 'deep-dive' ? ', to go deeper' : ''}{s.free ? '' : ', paid'})</span>
                  <br /><span class="quiet">{s.locator}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    {
      inRoles.length > 0 && (
        <section aria-labelledby="roles">
          <h2 id="roles">Which roles ask for it</h2>
          <ul class="role-uses">
            {inRoles.map(({ role, tier }) => (
              <li>
                <a href={`/roles/${role.id}`}>{role.title}</a>
                <span class="quiet"> {tier.id === 'hire' ? 'to get hired' : tier.id === 'firstYear' ? 'in the first year' : 'good to have'}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="neighbours" aria-labelledby="around">
      <h2 id="around">Before and after</h2>
      <div class="lanes">
        <div class="lane">
          <h3>Learn first</h3>
          {before.length === 0 ? <p class="quiet">Nothing. You can start here.</p> : (
            <ul>{before.map((x) => <li data-area={x.area}><a href={`/concepts/${x.id}`}>{x.title}</a></li>)}</ul>
          )}
          {helpful.length > 0 && (
            <p class="faint small">Helps to know: {helpful.map((x, i) => (
              <>{i > 0 && (i === helpful.length - 1 ? ' and ' : ', ')}<a href={`/concepts/${x.id}`}>{x.title}</a></>
            ))}</p>
          )}
        </div>
        <div class="lane this" data-area={concept.area}>
          <span class="dot" aria-hidden="true"></span>
          <strong>{concept.title}</strong>
        </div>
        <div class="lane">
          <h3>Opens up</h3>
          {after.length === 0 ? <p class="quiet">Nothing else on the map yet.</p> : (
            <ul>{after.map((x) => <li data-area={x.area}><a href={`/concepts/${x.id}`}>{x.title}</a></li>)}</ul>
          )}
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .head { display: grid; gap: 14px; padding: 8px 0 8px; }
  .head h1 { font-size: clamp(2rem, 6.5vw, 3.4rem); }
  .chips { display: flex; gap: 12px; align-items: center; }
  .role-uses { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 6px; }
  .role-uses a { font-family: var(--sign); font-stretch: 88%; font-weight: 680; font-size: 1.15rem; }
  .summary { font-size: 1.25rem; line-height: 1.5; max-width: 56ch; }

  section { margin-top: 44px; }
  h2 { margin-bottom: 8px; }

  .picks { margin-top: 14px; }
  .more { margin-top: 22px; }
  .more ul { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 10px; }
  .small { font-size: 0.9375rem; margin-top: 8px; }

  .lanes { display: grid; grid-template-columns: 1fr auto 1fr; gap: 28px; align-items: start; margin-top: 16px; }
  .lane h3 { font-size: 1.05rem; color: var(--ink-2); margin-bottom: 8px; }
  .lane ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .lane li { display: flex; align-items: center; gap: 10px; }
  .lane li::before { content: ''; width: 14px; height: 14px; border-radius: 50%; border: 3px solid var(--line); background: var(--paper); flex: none; }
  .this { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 26px 8px 0; text-align: center; max-width: 16ch; font-family: var(--sign); font-stretch: 85%; font-size: 1.15rem; }
  .this .dot { width: 28px; height: 28px; border-radius: 50%; background: var(--yellow); border: 4px solid var(--ink); }

  @media (max-width: 640px) {
    .lanes { grid-template-columns: 1fr; gap: 20px; }
    .this { flex-direction: row; padding: 0; max-width: none; text-align: left; }
  }
</style>
