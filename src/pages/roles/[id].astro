---
import Base from '../../layouts/Base.astro';
import RolePlanner from '../../components/RolePlanner';
import { content, jobStarts, listOf, plannerNodes } from '../../lib/site';
import { jobLinks, searchTerm, sitesFor, startupMatch } from '../../lib/jobs';
import { BACKGROUND_GROUPS, TIERS } from '../../lib/schema';
import '../../styles/route.css';
import '../../styles/planner.css';
import '../../styles/map.css';
import '../../styles/picks.css';

export function getStaticPaths() {
  return content().roles.map((r) => ({ params: { id: r.id } }));
}

const c = content();
const role = c.roles.find((r) => r.id === Astro.params.id)!;
const family = c.families.find((f) => f.id === role.family)!;
const counts = TIERS.map((t) => ({ ...t, n: role.tiers[t.id].length })).filter((t) => t.n > 0);

const term = searchTerm(role);
const sites = sitesFor(c.jobSites, role);
const links = jobLinks(role, sites);
const yc = startupMatch(sites, c.startups);
// A job title: which route it builds on, and what it adds.
const base = role.variantOf ? c.roles.find((r) => r.id === role.variantOf) : undefined;
const titleOf = (id: string) => c.concepts.find((x) => x.id === id)?.title ?? id;
const added = base ? role.tiers.hire.filter((id) => !base.tiers.hire.includes(id)).map(titleOf) : [];
const removed = base ? base.tiers.hire.filter((id) => !role.tiers.hire.includes(id)).map(titleOf) : [];
const siblings = base ? c.roles.filter((r) => r.variantOf === base.id && r.id !== role.id) : c.roles.filter((r) => r.variantOf === role.id);
const dateOf = (d: string) => new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const posting = role.posting;
const isJob = role.kind !== 'exam';
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const monthName = (ym: string) => `${MONTHS[Number(ym.slice(5, 7)) - 1]} ${ym.slice(0, 4)}`;
---

<Base title={role.title} description={role.summary} wide>
  <header class="role-head">
    <p class="crumbs quiet"><a href="/roles">Roles</a> / {family.title}</p>
    <h1><span class="board">{role.title}</span></h1>
    <p class="lede quiet">{role.summary}</p>
    {base && (
      <p class="route-of">
        The route is <a href={`/roles/${base.id}`}>{base.title}</a>
        {added.length > 0 ? `, with ${listOf(added)} on the hiring list` : ''}{removed.length > 0 ? ` instead of ${listOf(removed)}` : ''}.
      </p>
    )}
    {siblings.length > 0 && (
      <p class="also quiet">
        {base ? 'Other titles on this route: ' : 'Also posted as: '}
        {siblings.slice(0, 14).map((r, i) => (
          <>{i > 0 && ', '}<a href={`/roles/${r.id}`}>{r.title}</a></>
        ))}
        {siblings.length > 14 && `, and ${siblings.length - 14} more`}.
      </p>
    )}
    {isJob && <p class="jump"><a href="#the-job">{posting ? 'What the job looks like, from real listings' : 'See real openings for this job'}</a></p>}
    {
      role.evidence ? (
        <p class="evidence">
          Based on {role.evidence.postings} job postings ({role.evidence.region}, collected {role.evidence.collected}).
          {role.evidence.note && ` ${role.evidence.note}`}
        </p>
      ) : (
        <p class="evidence draft">
          {role.kind === 'exam'
            ? 'Draft. Based on the published syllabus as we read it.'
            : posting
              ? 'Draft. The route is our judgement, checked against real listings below.'
              : 'Draft. This route is our judgement and hasn’t been checked against real job postings yet.'}{' '}
          <a href="https://github.com/shivemn/terminus/blob/main/docs/ROLES.md">How roles get checked</a>
        </p>
      )
    }
  </header>

  <RolePlanner
    client:load
    role={{ id: role.id, title: role.title, tiers: role.tiers }}
    concepts={plannerNodes(c)}
    areas={c.areas}
    tiers={TIERS}
    backgrounds={c.backgrounds}
    backgroundGroups={BACKGROUND_GROUPS}
    jobs={jobStarts(c)}
  />

  {
    isJob && (
      <section class="job" id="the-job" aria-labelledby="the-job-title">
        <h2 id="the-job-title">What the job looks like</h2>
        {posting ? (
          <>
            <p class="job-source quiet">
              Summarised in our own words from {posting.listings} entry-level listings on {posting.source}, {monthName(posting.collected)}.
              {' '}{posting.method}
            </p>
            <div class="job-grid">
              <div>
                <h3>What you'd do</h3>
                <ul class="job-doing">{posting.doing.map((d) => <li>{d}</li>)}</ul>
                <h3>Titles you'll see</h3>
                <p>{posting.titles.join(', ')}.</p>
                <h3>Experience asked for</h3>
                <p>{posting.experience}</p>
              </div>
              <div>
                <h3>What the listings ask for</h3>
                <p class="quiet small">Out of the {posting.tagged} listings that named skills. Listings show only a few tags, so the real numbers are higher.</p>
                <ul class="asks">
                  {posting.asks.map((a) => (
                    <li>
                      <span class="ask-name">{a.skill}</span>
                      <span class="ask-bar" aria-hidden="true"><span style={`width:${Math.round((a.listings / posting.tagged) * 100)}%`} /></span>
                      <span class="ask-n">{a.listings} of {posting.tagged}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </>
        ) : (
          <p class="quiet">We haven't summarised real listings for this role yet. The searches below show what's open today.</p>
        )}
        <div class="openings">
          <h3>See real openings now</h3>
          <div class="site-groups">
            {links.map((g) => (
              <div class="site-group">
                <h4>{g.title}</h4>
                <p class="boards">
                  {g.links.map((b) => (
                    <a class="board-link" href={b.url} rel="noopener" target="_blank">{b.name}{b.note && <span class="quiet"> ({b.note})</span>}</a>
                  ))}
                </p>
              </div>
            ))}
          </div>
          {yc && (
            <p class="yc-note">
              On {dateOf(yc.collected)}, YC startups based in India had {yc.n} {yc.n === 1 ? 'opening' : 'openings'} like this
              ({yc.kinds.join(', ').toLowerCase()}) across {yc.companies} {yc.companies === 1 ? 'company' : 'companies'};{' '}
              {yc.newGrad === 0 ? 'none were' : `${yc.newGrad} ${yc.newGrad === 1 ? 'was' : 'were'}`} open to new graduates or interns.
              {yc.top.length > 0 && ` The skills they named most: ${yc.top.join(', ')}.`}{' '}
              <a href="/startups">See the startups</a>
            </p>
          )}
          <p class="quiet small">Searches for “{term.replace(/\s+fresher$/i, '')}”. Read a few listings end to end: the skills repeat quickly.</p>
          {role.reference && (
            <p class="small">Official description: <a href={role.reference.url} rel="noopener">{role.reference.title}</a></p>
          )}
        </div>
      </section>
    )
  }

  <noscript>
    <section class="static-list">
      {counts.map((t) => (
        <>
          <h2>{t.title}</h2>
          <ul>{role.tiers[t.id].map((id) => <li><a href={`/concepts/${id}`}>{c.concepts.find((x) => x.id === id)!.title}</a></li>)}</ul>
        </>
      ))}
    </section>
  </noscript>
</Base>

<style>
  .role-head { max-width: 800px; display: grid; gap: 14px; }
  .role-head h1 { font-size: clamp(2.2rem, 7vw, 3.8rem); }
  .crumbs { font-size: 0.95rem; }
  .crumbs a { color: inherit; }
  .lede { font-size: 1.2rem; max-width: 58ch; }
  .evidence { font-size: 0.95rem; color: var(--ink-2); padding: 6px 12px; border-left: 5px solid var(--programming); background: var(--platform); }
  .evidence.draft { border-left-color: var(--warn); }
  .static-list { margin-top: 24px; }
  .jump { font-weight: 600; }
  .route-of { font-weight: 600; }
  .also { max-width: 90ch; font-size: 0.97rem; }

  .job { margin-top: 56px; padding-top: 28px; border-top: 4px solid var(--ink); }
  .job h2 { font-size: clamp(1.8rem, 5vw, 2.6rem); }
  .job h3 { font-size: 1.25rem; margin: 22px 0 8px; }
  .job-source { max-width: 70ch; margin-top: 8px; }
  .small { font-size: 0.92rem; }
  .job-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 64px; }
  .job-grid p, .job-doing { max-width: 64ch; }
  @media (max-width: 760px) { .job-grid { grid-template-columns: 1fr; } }
  .job-doing { padding-left: 1.2em; display: grid; gap: 6px; }
  .asks { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 10px; }
  .asks li { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: baseline; }
  .ask-bar { grid-column: 1 / -1; grid-row: 2; height: 10px; background: var(--platform); border: 1.5px solid var(--ink); }
  .ask-bar span { display: block; height: 100%; background: var(--yellow); border-right: 1.5px solid var(--ink); }
  .ask-n { font-variant-numeric: tabular-nums; color: var(--ink-2); font-size: 0.92rem; white-space: nowrap; }
  .openings { margin-top: 28px; padding: 16px 18px; background: var(--platform); border-left: 5px solid var(--yellow); }
  .openings h3 { margin-top: 0; }
  .site-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 14px 28px; margin: 10px 0 14px; }
  .site-group h4 { font-family: var(--sign); font-stretch: 88%; font-weight: 650; font-size: 1.05rem; color: var(--ink-2); margin: 0; }
  .boards { display: flex; flex-wrap: wrap; gap: 8px; margin: 6px 0 0; }
  .yc-note { max-width: 80ch; margin: 4px 0 10px; }
  .board-link { display: inline-block; padding: 6px 12px; border: 2px solid var(--ink); color: var(--ink); text-decoration: none; font-weight: 600; background: var(--paper); }
  .board-link:hover, .board-link:focus-visible { background: var(--yellow); color: #000; }
</style>
