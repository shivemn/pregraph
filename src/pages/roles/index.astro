---
import Base from '../../layouts/Base.astro';
import { content } from '../../lib/site';

const c = content();
const groups = c.families
  .map((f) => ({ family: f, roles: c.roles.filter((r) => r.family === f.id) }))
  .filter((g) => g.roles.length > 0);
---

<Base title="Roles" description="Pick a job and see what it takes to get hired, starting from what you already know." wide>
  <header class="head">
    <h1><span class="board">All roles</span></h1>
    <p class="lede quiet">
      Pick a job. You'll see what it takes to get hired, then what the first year expects, starting from what you
      already know. Every role is a draft until it has been checked against real job postings.
    </p>
    <nav class="lines" aria-label="Families of jobs">
      {groups.map(({ family, roles }) => (
        <a href={`#${family.id}`} data-family={family.id}>{family.short ?? family.title} <span>{roles.length}</span></a>
      ))}
    </nav>
  </header>

  {
    groups.map(({ family, roles }) => (
      <section id={family.id} data-family={family.id} aria-labelledby={`${family.id}-title`}>
        <h2 id={`${family.id}-title`}>{family.title}</h2>
        <ul class="role-grid">
          {roles.map((r) => (
            <li>
              <a class="role-box" href={`/roles/${r.id}`}>
                <span class="role-title">{r.title}</span>
                <span class="role-summary">{r.summary}</span>
                <span class="role-foot">
                  {r.kind === 'exam' ? `${r.tiers.hire.length} syllabus topics.` : `${r.tiers.hire.length} on the hiring list.`}
                  {r.posting && ' Real listings summarised.'}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .head { max-width: 800px; display: grid; gap: 14px; }
  h1 { padding-top: 8px; font-size: clamp(2.2rem, 7vw, 3.6rem); }
  .lede { font-size: 1.1875rem; max-width: 60ch; }

  .lines { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .lines a {
    font-family: var(--sign); font-stretch: 88%; font-weight: 700; font-size: 1.05rem; text-decoration: none;
    padding: 5px 12px 3px; background: var(--family); color: var(--l-text);
  }
  .lines a[data-family='exams'] { background: var(--ink); color: var(--paper); }
  .lines a span { opacity: 0.8; font-weight: 600; }
  .lines a:hover, .lines a:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }

  section { margin-top: 52px; scroll-margin-top: 90px; }
  h2 { font-size: 1.6rem; padding-bottom: 8px; border-bottom: 6px solid var(--family, var(--ink)); }

  .role-grid { list-style: none; padding: 0; margin: 18px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 760px) { .role-grid { grid-template-columns: 1fr; } }
  .role-grid li { display: flex; }
  .role-box {
    flex: 1; display: grid; grid-template-rows: auto 1fr auto; gap: 8px;
    padding: 16px 18px 14px 20px; border: 2px solid var(--ink); border-left: 8px solid var(--family, var(--ink));
    background: var(--paper); color: var(--ink); text-decoration: none;
  }
  .role-box:hover, .role-box:focus-visible { background: var(--platform); }
  .role-box:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .role-title { font-family: var(--sign); font-stretch: 85%; font-size: 1.5rem; font-weight: 720; line-height: 1.1; }
  .role-box:hover .role-title { text-decoration: underline; text-decoration-thickness: 2px; }
  .role-summary { color: var(--ink-2); line-height: 1.5; }
  .role-foot { font-size: 0.9rem; font-weight: 600; color: var(--ink-2); padding-top: 8px; border-top: 1px solid var(--rule); }
</style>
