---
// YC startups in India that were hiring, from a dated snapshot of the YC
// directory (content/startups/yc-india.json). Postings change every week,
// so the page summarises them and links to each company's live jobs page.
import Base from '../layouts/Base.astro';
import { content } from '../lib/site';

const c = content();
const s = c.startups;
const conceptIds = new Set(c.concepts.map((x) => x.id));
const toolIds = new Set(c.toolGroups.flatMap((g) => g.tools));
const dateOf = (d: string) => new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

// Skills as YC names them, and the Terminus page that teaches each one.
const SKILL_PAGE: Record<string, string> = {
  Python: 'programming-basics', AWS: 'cloud-basics', React: 'react', JavaScript: 'javascript', 'React Native': 'react-native',
  PostgreSQL: 'sql', SQL: 'sql', Figma: 'figma', Angular: 'angular', 'Node.js': 'nodejs', Java: 'java', 'Machine learning': 'machine-learning',
  'Software architecture': 'system-design', Kubernetes: 'kubernetes', 'Data analytics': 'project-data-analysis', Flask: 'backend-framework',
  Microservices: 'distributed-systems', CSS: 'html-css', HTML: 'html-css', Go: 'go', TypeScript: 'typescript', Docker: 'docker',
  'AI agents': 'llm-apis', LLMs: 'llm-basics', PyTorch: 'pytorch', NLP: 'nlp', 'Computer vision': 'computer-vision', Flutter: 'flutter',
  'Deep learning': 'deep-learning', 'Reinforcement learning': 'reinforcement-learning', Transformers: 'transformers', C: 'c-and-memory', 'C++': 'cpp',
};
const pageFor = (skill: string) => {
  const id = SKILL_PAGE[skill];
  if (!id || !conceptIds.has(id)) return undefined;
  return toolIds.has(id) ? `/tools/${id}` : `/concepts/${id}`;
};

// Kinds of posting, and the Terminus route that leads to each.
const KIND_ROLE: Record<string, string> = {
  'Full stack': 'full-stack-engineer', Backend: 'backend-engineer', Frontend: 'frontend-engineer', Product: 'product-manager',
  'Data science': 'data-scientist', 'Machine learning': 'ml-engineer', Finance: 'financial-analyst', 'Product design': 'ui-ux-designer',
  'UI / UX': 'ui-ux-designer', Devops: 'devops-engineer', 'QA engineer': 'qa-engineer', 'Embedded systems': 'embedded-engineer', Robotics: 'embedded-engineer',
};
const roleTitle = new Map(c.roles.map((r) => [r.id, r.title]));
const kinds = Object.entries(s.kinds).sort((a, b) => b[1].n - a[1].n);
const maxSkill = s.skills[0]![1];
const maxExp = Math.max(...s.experience.map(([, n]) => n));
const freshers = s.experience.filter(([k]) => /new grads|Internship/.test(k)).reduce((n, [, v]) => n + v, 0);
const companies = [...s.companies].sort((a, b) => b.newGrad - a.newGrad || b.open - a.open);
const filterKinds = [...new Set(s.companies.flatMap((x) => x.kinds))].sort();
---

<Base title="Startups" description="YC startups in India that are hiring: what they ask for, and where to see their jobs." wide>
  <header class="head">
    <h1><span class="board">Startups</span></h1>
    <p class="lede quiet">
      Startups funded by Y Combinator (YC), the best-known startup accelerator, that are based in India and were hiring on
      {' '}{dateOf(s.collected)}. Each company links to its live jobs page on YC, where you can read every posting and apply.
    </p>
    <p class="honest">
      A straight answer before you start: of the {s.counted} engineering, product, design and finance openings,
      {' '}<strong>{freshers} were open to new graduates or interns</strong>. Most asked for one to three years or more. Startups
      are worth a look, but your first job is more likely to come from the job boards on each role page.
    </p>
  </header>

  <div class="two">
    <section aria-labelledby="skills-title">
      <h2 id="skills-title">What they ask for</h2>
      <p class="quiet small">Skills named on the {s.withSkills} postings that listed any. Linked ones have a route on Terminus.</p>
      <ul class="bars">
        {s.skills.slice(0, 16).map(([skill, n]) => {
          const href = pageFor(skill);
          return (
            <li>
              <span class="bar-name">{href ? <a href={href}>{skill}</a> : skill}</span>
              <span class="bar" aria-hidden="true"><span style={`width:${(n / maxSkill) * 100}%`} /></span>
              <span class="bar-n">{n}</span>
            </li>
          );
        })}
      </ul>
    </section>
    <section aria-labelledby="exp-title">
      <h2 id="exp-title">Experience asked for</h2>
      <p class="quiet small">Across all {s.counted} openings.</p>
      <ul class="bars">
        {s.experience.map(([k, n]) => (
          <li data-fresher={/new grads|Internship/.test(k) ? 'true' : undefined}>
            <span class="bar-name">{k === 'Any (new grads ok)' ? 'New graduates welcome' : k}</span>
            <span class="bar" aria-hidden="true"><span style={`width:${(n / maxExp) * 100}%`} /></span>
            <span class="bar-n">{n}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section aria-labelledby="kinds-title">
    <h2 id="kinds-title">By kind of job</h2>
    <div class="table-wrap">
      <table class="kinds">
        <thead>
          <tr><th scope="col">Kind</th><th scope="col" class="num">Openings</th><th scope="col" class="num">For new grads</th><th scope="col">Skills named most</th><th scope="col">Route on Terminus</th></tr>
        </thead>
        <tbody>
          {kinds.map(([k, v]) => (
            <tr>
              <th scope="row">{k}</th>
              <td class="num">{v.n}</td>
              <td class="num">{v.newGrad}</td>
              <td>{v.top.slice(0, 4).map(([x]) => x).join(', ') || <span class="quiet">None listed</span>}</td>
              <td>{KIND_ROLE[k] ? <a href={`/roles/${KIND_ROLE[k]}`}>{roleTitle.get(KIND_ROLE[k]!)}</a> : <span class="quiet">Not yet</span>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="companies-title">
    <h2 id="companies-title">The companies</h2>
    <div class="filters" data-filters>
      <label class="check"><input type="checkbox" data-newgrad /> Only ones hiring new graduates or interns</label>
      <label>
        <span class="sr-only">Kind of job</span>
        <select data-kind>
          <option value="">Any kind of job</option>
          {filterKinds.map((k) => <option value={k}>{k}</option>)}
        </select>
      </label>
      <span class="quiet small" data-count aria-live="polite">{companies.length} companies</span>
    </div>
    <ul class="companies">
      {companies.map((x) => (
        <li data-newgrad={x.newGrad > 0 ? 'true' : 'false'} data-kinds={x.kinds.join('|')}>
          <a class="company" href={`https://www.ycombinator.com/companies/${x.slug}/jobs`} rel="noopener" target="_blank">
            <span class="company-top">
              <span class="company-name">{x.name}</span>
              <span class="company-batch">YC {x.batch}</span>
            </span>
            <span class="company-one">{x.one}</span>
            <span class="company-kinds">{x.kinds.join(', ')}</span>
            <span class="company-foot">
              {x.city}. {x.open} {x.open === 1 ? 'opening' : 'openings'}{x.newGrad > 0 && `, ${x.newGrad} for new grads or interns`}.
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="quiet small">
      Also hiring then, but not for engineering, product, design or finance: {s.notHiringTech.join(', ')}.
    </p>
  </section>

  <section aria-labelledby="more-title">
    <h2 id="more-title">More places to find startup jobs</h2>
    <ul class="more">
      <li><a href="https://www.ycombinator.com/jobs/role/software-engineer/india" rel="noopener">YC startup jobs in India</a>, by kind of job, always current.</li>
      <li><a href="https://www.ycombinator.com/jobs/role/software-engineer/remote" rel="noopener">YC startup jobs you can do remotely</a>, many open to people in India.</li>
      <li><a href={s.url} rel="noopener">The YC directory, filtered to India and hiring</a>, for the full and current list.</li>
      <li><a href="https://wellfound.com/role/l/software-engineer/india" rel="noopener">Wellfound</a>, the largest startup job board, with startups beyond YC.</li>
    </ul>
    <p class="quiet small">
      Collected from the YC directory on {dateOf(s.collected)}: {s.companiesHiring} companies, {s.postings} postings, of which
      {' '}{s.counted} were counted here. {s.countedNote} Postings change every week; the links always show today's.
    </p>
  </section>
</Base>

<script>
  const box = document.querySelector<HTMLElement>('[data-filters]');
  if (box) {
    const newGrad = box.querySelector<HTMLInputElement>('[data-newgrad]')!;
    const kind = box.querySelector<HTMLSelectElement>('[data-kind]')!;
    const count = box.querySelector<HTMLElement>('[data-count]')!;
    const items = [...document.querySelectorAll<HTMLLIElement>('.companies > li')];
    const apply = () => {
      let n = 0;
      for (const li of items) {
        const show = (!newGrad.checked || li.dataset.newgrad === 'true') && (!kind.value || li.dataset.kinds!.split('|').includes(kind.value));
        li.hidden = !show;
        if (show) n++;
      }
      count.textContent = `${n} ${n === 1 ? 'company' : 'companies'}`;
    };
    newGrad.addEventListener('change', apply);
    kind.addEventListener('change', apply);
  }
</script>

<style>
  .head { max-width: 860px; display: grid; gap: 14px; }
  h1 { padding-top: 8px; font-size: clamp(2.2rem, 7vw, 3.6rem); }
  .lede { font-size: 1.1875rem; max-width: 64ch; }
  .honest { max-width: 72ch; padding: 10px 14px; border-left: 5px solid var(--yellow); background: var(--platform); }
  section { margin-top: 52px; }
  h2 { font-size: 1.6rem; margin-bottom: 6px; }
  .small { font-size: 0.92rem; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 64px; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
  .bars { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 8px; }
  .bars li { display: grid; grid-template-columns: minmax(130px, 34%) 1fr 34px; gap: 12px; align-items: center; }
  .bar { height: 12px; background: var(--platform); border: 1.5px solid var(--ink); }
  .bar span { display: block; height: 100%; background: var(--ink-2); }
  .bars li[data-fresher] .bar span { background: var(--yellow); }
  .bars li[data-fresher] .bar-name { font-weight: 700; }
  .bar-n { text-align: right; font-variant-numeric: tabular-nums; color: var(--ink-2); }

  .table-wrap { overflow-x: auto; margin-top: 12px; }
  .kinds { width: 100%; border-collapse: collapse; font-size: 0.97rem; }
  .kinds th, .kinds td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .kinds thead th { border-bottom: 3px solid var(--ink); font-family: var(--sign); font-stretch: 88%; font-size: 1.05rem; }
  .kinds .num { text-align: right; font-variant-numeric: tabular-nums; }
  .kinds tbody th { font-weight: 700; }

  .filters { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin: 12px 0 16px; }
  .check { display: inline-flex; gap: 8px; align-items: center; font-weight: 600; }
  .check input { width: 18px; height: 18px; accent-color: var(--ink); }
  .filters select { font: inherit; padding: 6px 10px; border: 2px solid var(--ink); background: var(--paper); color: var(--ink); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .companies { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); gap: 14px; }
  .companies li { display: flex; }
  .companies li[hidden] { display: none; }
  .company {
    flex: 1; display: grid; grid-template-rows: auto auto 1fr auto; gap: 6px; padding: 14px 16px; border: 2px solid var(--ink);
    color: var(--ink); text-decoration: none; background: var(--paper);
  }
  .company:hover, .company:focus-visible { background: var(--platform); }
  .company-top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .company-name { font-family: var(--sign); font-stretch: 85%; font-weight: 720; font-size: 1.35rem; line-height: 1.1; }
  .company:hover .company-name { text-decoration: underline; }
  .company-batch { font-size: 0.85rem; font-weight: 700; padding: 1px 6px; background: var(--yellow); color: #000; white-space: nowrap; }
  .company-one { color: var(--ink-2); }
  .company-kinds { font-size: 0.9rem; font-weight: 600; }
  .company-foot { font-size: 0.88rem; color: var(--ink-2); padding-top: 6px; border-top: 1px solid var(--rule); }

  .more { padding-left: 1.2em; display: grid; gap: 6px; margin: 10px 0 14px; }
</style>
