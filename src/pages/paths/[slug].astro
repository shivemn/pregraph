---
import Base from '../../layouts/Base.astro';
import PathPlanner from '../../components/PathPlanner';
import { content, pathContext, plannerNodes } from '../../lib/site';
import '../../styles/route.css';
import '../../styles/planner.css';
import '../../styles/map.css';

export function getStaticPaths() {
  return content().paths.map((p) => ({ params: { slug: p.slug } }));
}

const c = content();
const path = c.paths.find((p) => p.slug === Astro.params.slug)!;
const { background, goals } = pathContext(c, path);
---

<Base title={path.title} description={path.tagline} wide>
  <header class="path-head">
    <h1>{path.title}</h1>
    <p class="lede quiet">{path.tagline}</p>
  </header>
  <PathPlanner
    client:load
    slug={path.slug}
    concepts={plannerNodes(c)}
    areas={c.areas}
    goals={goals.map(({ id, title, description, targets }) => ({ id, title, description, targets }))}
    backgroundTitle={background.title}
    backgroundKnows={background.knows}
  />
</Base>

<style>
  .path-head { max-width: 760px; display: grid; gap: 12px; }
  .lede { font-size: 1.1875rem; max-width: 56ch; }
</style>
