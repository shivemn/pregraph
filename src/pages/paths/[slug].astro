---
import Base from '../../layouts/Base.astro';
import PathPlanner from '../../components/PathPlanner';
import { loadContent } from '../../lib/content';
import type { ConceptNode } from '../../lib/graph';

export function getStaticPaths() {
  return loadContent().paths.map((p) => ({ params: { slug: p.slug } }));
}

const content = loadContent();
const path = content.paths.find((p) => p.slug === Astro.params.slug)!;
const background = content.backgrounds.find((b) => b.id === path.background)!;
const goal = content.goals.find((g) => g.id === path.goals[0])!;

// Only what the planner needs goes to the browser — keeps the page small.
const nodes: ConceptNode[] = content.concepts.map(({ id, title, area, hours, requires, recommends }) => ({
  id, title, area, hours, requires, recommends,
}));
const knownTitles = background.knows.map((k) => content.concepts.find((c) => c.id === k)!.title);
---

<Base title={path.title} description={path.tagline}>
  <h1>{path.title}</h1>
  <p class="muted">{path.tagline}</p>
  <div class="card summary">
    <div><span class="label">From</span> <strong>{background.title}</strong> — already covers {knownTitles.join(', ')}.</div>
    <div><span class="label">To</span> <strong>{goal.title}</strong> — {goal.description}</div>
  </div>
  <PathPlanner
    client:load
    slug={path.slug}
    concepts={nodes}
    goals={goal.targets}
    backgroundKnows={background.knows}
  />
</Base>

<style>
  .summary { display: grid; gap: 6px; margin: 16px 0 24px; }
  .label { display: inline-block; min-width: 3em; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
</style>
