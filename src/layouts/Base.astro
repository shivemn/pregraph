---
import '@fontsource/mukta/latin-400.css';
import '@fontsource/mukta/latin-600.css';
import '@fontsource/mukta/latin-700.css';
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
  /** Wider main column, for pages with a sidebar. */
  wide?: boolean;
}
const { title, description = 'A study plan that starts from what you already know.', wide = false } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = title === 'Terminus' ? 'Terminus: a study plan that starts from what you know' : `${title} | Terminus`;
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1114" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Terminus" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="masthead-inner">
        <a href="/" class="wordmark" aria-label="Terminus home">
          <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
            <rect x="1.5" y="1.5" width="29" height="29" fill="#ffcc00" stroke="#000" stroke-width="3" />
            <path d="M7 8.5h18M16 8.5V27" stroke="#000" stroke-width="5" />
            <circle cx="16" cy="20" r="3.4" fill="#ffcc00" stroke="#000" stroke-width="2.4" />
          </svg>
          Terminus
        </a>
        <nav aria-label="Main">
          <a href="/roles" aria-current={path.startsWith('/roles') ? 'page' : undefined}>All roles</a>
          <a href="/tools" aria-current={path.startsWith('/tools') ? 'page' : undefined}>Tools</a>
          <a href="/practice" aria-current={path.startsWith('/practice') ? 'page' : undefined}>Practice</a>
        </nav>
        <Search />
      </div>
    </header>
    <main id="main" class:list={['page', { wide }]}>
      <slot />
    </main>
    <footer class="colophon">
      <p>
        Terminus points to free books, lectures and practice. It never copies them.
        Found a dead link, or know something better? <a href="https://github.com/shivemn/terminus/issues">Tell us on GitHub</a>.
      </p>
    </footer>
  </body>
</html>
