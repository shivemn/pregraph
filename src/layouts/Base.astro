---
import '@fontsource-variable/overpass';
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
  /** Wider main column, for pages with a sidebar. */
  wide?: boolean;
}
const { title, description = 'A study plan that starts from what you already know.', wide = false } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e141b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === 'Pregraph' ? 'Pregraph: a study plan that starts from what you know' : `${title} | Pregraph`}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <a href="/" class="wordmark" aria-label="Pregraph home">
        <svg viewBox="0 0 34 14" width="34" height="14" aria-hidden="true">
          <path d="M5 7h24" stroke="currentColor" stroke-width="2.5" />
          <circle cx="5" cy="7" r="4" fill="var(--paper)" stroke="currentColor" stroke-width="2.5" />
          <circle cx="29" cy="7" r="5" fill="currentColor" />
        </svg>
        Pregraph
      </a>
      <nav aria-label="Routes">
        <a href="/paths/maths-to-cs" aria-current={path.startsWith('/paths/maths-to-cs') ? 'page' : undefined}>Maths to CS</a>
        <a href="/paths/from-zero" aria-current={path.startsWith('/paths/from-zero') ? 'page' : undefined}>From zero</a>
      </nav>
      <Search />
    </header>
    <main id="main" class:list={['page', { wide }]}>
      <slot />
    </main>
    <footer class="colophon">
      <p>
        Pregraph links to free books, courses and lecture notes. It never copies them.
        Found a dead link or a better source? <a href="https://github.com/shivemn/pregraph/issues">Tell us on GitHub</a>.
      </p>
    </footer>
  </body>
</html>
