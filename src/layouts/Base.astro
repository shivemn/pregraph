---
import '@fontsource/mukta/latin-400.css';
import '@fontsource/mukta/latin-600.css';
import '@fontsource/mukta/latin-700.css';
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
  /** Wider main column, for pages with a sidebar. */
  wide?: boolean;
}
const { title, description = 'A study plan that starts from what you already know.', wide = false } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = title === 'Pregraph' ? 'Pregraph: a study plan that starts from what you know' : `${title} | Pregraph`;
const canonical = Astro.site ? new URL(path, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1114" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pregraph" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="masthead-inner">
        <a href="/" class="wordmark" aria-label="Pregraph home">
          <svg viewBox="0 0 40 16" width="40" height="16" aria-hidden="true">
            <path d="M6 8h28" stroke="currentColor" stroke-width="4" />
            <circle cx="6" cy="8" r="4.5" fill="var(--paper)" stroke="currentColor" stroke-width="2.5" />
            <circle cx="20" cy="8" r="4.5" fill="var(--paper)" stroke="currentColor" stroke-width="2.5" />
            <circle cx="34" cy="8" r="5.5" fill="var(--yellow)" stroke="currentColor" stroke-width="2.5" />
          </svg>
          Pregraph
        </a>
        <nav aria-label="Main">
          <a href="/roles" aria-current={path.startsWith('/roles') ? 'page' : undefined}>All roles</a>
        </nav>
        <Search />
      </div>
    </header>
    <main id="main" class:list={['page', { wide }]}>
      <slot />
    </main>
    <footer class="colophon">
      <p>
        Pregraph points to free books, lectures and practice. It never copies them.
        Found a dead link, or know something better? <a href="https://github.com/shivemn/pregraph/issues">Tell us on GitHub</a>.
      </p>
    </footer>
  </body>
</html>
