---
// The read / watch / practise icons. Stroke and fill follow the area colour (--line).
interface Props {
  medium: 'read' | 'watch' | 'practice';
}
const { medium } = Astro.props;
---

{medium === 'read' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5C6 4 9 4 12 6c3-2 6-2 9-.5V19c-3-1.5-6-1.5-9 .5-3-2-6-2-9-.5z" /><path d="M12 6v13.5" /></svg>}
{medium === 'watch' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="M10 9.2v5.6l4.6-2.8z" class="fill" /></svg>}
{medium === 'practice' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.2-4.6L15.6 5a1.9 1.9 0 0 1 2.7 0l.7.7a1.9 1.9 0 0 1 0 2.7L8.6 18.8z" /><path d="M13.5 7l3.5 3.5" /></svg>}
