---
// Search box in the header. Plain TypeScript, no framework, so it costs every
// page only a few kilobytes. Press "/" anywhere to jump to it.
import { content } from '../lib/site';
const areaTitles = Object.fromEntries(content().areas.map((a) => [a.id, a.title]));
---

<div class="search" data-areas={JSON.stringify(areaTitles)}>
  <label class="visually-hidden" for="site-search">Search concepts and resources</label>
  <input
    id="site-search"
    type="search"
    placeholder="Search, e.g. graphs or OSTEP"
    autocomplete="off"
    spellcheck="false"
    role="combobox"
    aria-expanded="false"
    aria-controls="search-results"
    aria-autocomplete="list"
  />
  <kbd aria-hidden="true">/</kbd>
  <ul id="search-results" role="listbox" hidden></ul>
</div>

<script>
  import { search, type SearchDoc } from '../lib/search';

  const root = document.querySelector<HTMLElement>('.search')!;
  const input = root.querySelector<HTMLInputElement>('input')!;
  const list = root.querySelector<HTMLUListElement>('ul')!;
  const areas: Record<string, string> = JSON.parse(root.dataset.areas ?? '{}');

  let docs: SearchDoc[] | null = null;
  let loading: Promise<void> | null = null;
  let active = -1;

  const load = () =>
    (loading ??= fetch('/search.json')
      .then((r) => r.json())
      .then((d: SearchDoc[]) => { docs = d; })
      .catch(() => { loading = null; }));

  const items = () => [...list.querySelectorAll<HTMLAnchorElement>('a')];

  function setActive(i: number) {
    const all = items();
    active = all.length === 0 ? -1 : (i + all.length) % all.length;
    all.forEach((a, j) => a.setAttribute('aria-selected', String(j === active)));
    if (active >= 0) input.setAttribute('aria-activedescendant', all[active]!.id);
    else input.removeAttribute('aria-activedescendant');
  }

  function close() {
    list.hidden = true;
    input.setAttribute('aria-expanded', 'false');
    active = -1;
  }

  function render() {
    const q = input.value;
    if (!q.trim()) return close();
    if (!docs) {
      load()?.then(render);
      return;
    }
    const hits = search(docs, q);
    list.replaceChildren();
    if (hits.length === 0) {
      const li = document.createElement('li');
      li.className = 'empty';
      li.textContent = `Nothing matches "${q.trim()}". Try a broader word, like "memory" or "graphs".`;
      list.append(li);
    }
    hits.forEach(({ doc }, i) => {
      const li = document.createElement('li');
      li.dataset.area = doc.area;
      const a = document.createElement('a');
      a.href = `/concepts/${doc.id}`;
      a.id = `search-hit-${i}`;
      a.setAttribute('role', 'option');
      const t = document.createElement('span');
      t.className = 'hit-title';
      t.textContent = doc.title;
      const s = document.createElement('span');
      s.className = 'hit-area';
      s.textContent = areas[doc.area] ?? doc.area;
      a.append(t, s);
      li.append(a);
      list.append(li);
    });
    list.hidden = false;
    input.setAttribute('aria-expanded', 'true');
    setActive(hits.length > 0 ? 0 : -1);
  }

  input.addEventListener('focus', () => { load(); });
  input.addEventListener('input', render);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Enter' && active >= 0) { e.preventDefault(); items()[active]?.click(); }
    else if (e.key === 'Escape') { input.value = ''; close(); input.blur(); }
  });
  document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) close(); });
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !t.closest('input, textarea, [contenteditable]')) {
      e.preventDefault();
      input.focus();
    }
  });
</script>

<style>
  .search { position: relative; margin-left: auto; width: min(320px, 100%); }
  input {
    width: 100%;
    font: inherit; font-size: 0.9375rem;
    padding: 8px 34px 8px 12px;
    border: 1px solid var(--rule); border-radius: 8px;
    background: var(--surface); color: var(--ink);
  }
  input::placeholder { color: var(--ink-3); }
  input::-webkit-search-cancel-button { display: none; }
  kbd {
    position: absolute; right: 9px; top: 50%; transform: translateY(-50%);
    font: inherit; font-size: 0.75rem; color: var(--ink-3);
    border: 1px solid var(--rule); border-radius: 4px; padding: 0 6px;
  }
  input:focus + kbd { display: none; }
  ul {
    position: absolute; z-index: 20; top: calc(100% + 6px); left: 0; right: 0;
    list-style: none; margin: 0; padding: 6px;
    background: var(--surface); border: 1px solid var(--rule); border-radius: 10px;
    box-shadow: 0 12px 32px -12px color-mix(in srgb, var(--ink) 35%, transparent);
    max-height: 60vh; overflow: auto;
  }
  ul :global(a) {
    display: grid; gap: 1px;
    padding: 7px 10px; border-radius: 6px; text-decoration: none;
    border-left: 3px solid var(--line);
  }
  ul :global(a[aria-selected='true']), ul :global(a:hover) { background: color-mix(in srgb, var(--line) 12%, transparent); }
  ul :global(.hit-title) { font-weight: 650; }
  ul :global(.hit-area) { font-size: 0.8125rem; color: var(--ink-3); }
  ul :global(.empty) { padding: 10px; color: var(--ink-2); font-size: 0.9375rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 640px) {
    .search { margin-left: 0; width: 100%; order: 3; }
    kbd { display: none; }
  }
</style>
